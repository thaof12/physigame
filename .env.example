# ============================================================
# HƯỚNG DẪN: Copy file này thành .env và điền giá trị thực
# ============================================================

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Vite Frontend env vars (must start with VITE_)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# [QUAN TRỌNG] URL của backend server (Render.com URL khi deploy production)
# - Development: để trống (tự dùng http://localhost:5002)
# - Production:  https://physigame-backend.onrender.com (điền vào Vercel env vars)
VITE_API_URL=

# JWT Secret
JWT_SECRET=your-secret-key

# Server
PORT=5002
NODE_ENV=development

# Gmail SMTP Credentials
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-app-password

# Dialogflow chatbot config
VITE_DF_PROJECT_ID=
VITE_DF_AGENT_ID=
VITE_DF_LANGUAGE_CODE=vi
VITE_DF_CHAT_TITLE=Physical-Assistant

# Dify AI Chatbot config
VITE_DIFY_API_BASE_URL=https://api.dify.ai/v1
VITE_DIFY_APP_API_KEY=
