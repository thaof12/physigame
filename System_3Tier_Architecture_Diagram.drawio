      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- TITLE BANNER -->
        <mxCell id="title" value="&lt;b&gt;EUREKA PHYSICS PLATFORM - 3-TIER SYSTEM ARCHITECTURE&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="860" height="30" as="geometry" />
        </mxCell>

        <!-- TIER 1: PRESENTATION LAYER -->
        <mxCell id="tier1" value="&lt;b&gt;1. PRESENTATION LAYER (Client - Web Browser)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=2;fontColor=#312E81;fontSize=13;fontStyle=1;startSize=30;rounded=1;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="55" width="860" height="175" as="geometry" />
        </mxCell>
        <mxCell id="card1_1" value="&lt;b&gt;React 18 SPA (Vite)&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#4B5563&quot; style=&quot;font-size: 11px;&quot;&gt;Tailwind CSS &amp;amp; Lucide Icons&lt;br/&gt;Single Page Application Core&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#818CF8;strokeWidth=1.5;shadow=1;fontSize=12;fontColor=#1E1B4B;align=center;" vertex="1" parent="tier1">
          <mxGeometry x="30" y="45" width="240" height="105" as="geometry" />
        </mxCell>
        <mxCell id="card1_2" value="&lt;b&gt;HTML5 Canvas / WebGL Engine&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#4B5563&quot; style=&quot;font-size: 11px;&quot;&gt;Virtual Physics Lab Simulations&lt;br/&gt;Interactive Experiment Canvas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#818CF8;strokeWidth=1.5;shadow=1;fontSize=12;fontColor=#1E1B4B;align=center;" vertex="1" parent="tier1">
          <mxGeometry x="300" y="45" width="260" height="105" as="geometry" />
        </mxCell>
        <mxCell id="card1_3" value="&lt;b&gt;React Context API&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#4B5563&quot; style=&quot;font-size: 11px;&quot;&gt;AuthContext | ThemeContext&lt;br/&gt;GameProgress State Manager&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#818CF8;strokeWidth=1.5;shadow=1;fontSize=12;fontColor=#1E1B4B;align=center;" vertex="1" parent="tier1">
          <mxGeometry x="590" y="45" width="240" height="105" as="geometry" />
        </mxCell>

        <!-- TIER 2: APPLICATION & SERVICES LAYER -->
        <mxCell id="tier2" value="&lt;b&gt;2. APPLICATION &amp;amp; SERVICES LAYER (Server &amp;amp; Realtime Gateway)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=13;fontStyle=1;startSize=30;rounded=1;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="305" width="860" height="185" as="geometry" />
        </mxCell>
        <mxCell id="card2_1" value="&lt;b&gt;Node.js &amp;amp; Express.js Server Engine&lt;/b&gt;&lt;br/&gt;&lt;hr style=&quot;border:0.5px solid #A7F3D0;&quot;/&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;API Routes:&lt;/b&gt; /api/settings, /api/leaderboard, /api/teacher-application&lt;br/&gt;&lt;b&gt;Security:&lt;/b&gt; JWT Token Verification &amp;amp; Role Middleware&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34D399;strokeWidth=1.5;shadow=1;fontSize=12;fontColor=#064E3B;align=center;spacing=4;" vertex="1" parent="tier2">
          <mxGeometry x="30" y="45" width="510" height="115" as="geometry" />
        </mxCell>
        <mxCell id="card2_2" value="&lt;b&gt;Supabase Realtime Gateway&lt;/b&gt;&lt;br/&gt;&lt;hr style=&quot;border:0.5px solid #A7F3D0;&quot;/&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;WebSocket Engine:&lt;/b&gt;&lt;br/&gt;Live Chat &amp;amp; PK Battle Synchronization&lt;br/&gt;Room Subscriptions (pk_room_{id})&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34D399;strokeWidth=1.5;shadow=1;fontSize=12;fontColor=#064E3B;align=center;spacing=4;" vertex="1" parent="tier2">
          <mxGeometry x="570" y="45" width="260" height="115" as="geometry" />
        </mxCell>

        <!-- TIER 3: DATA & INFRASTRUCTURE LAYER -->
        <mxCell id="tier3" value="&lt;b&gt;3. DATA &amp;amp; INFRASTRUCTURE LAYER (Supabase BaaS Cloud Infrastructure)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=2;fontColor=#0C4A6E;fontSize=13;fontStyle=1;startSize=30;rounded=1;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="565" width="860" height="175" as="geometry" />
        </mxCell>
        <mxCell id="card3_1" value="&lt;b&gt;Supabase PostgreSQL 15&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#0369A1&quot; style=&quot;font-size: 11px;&quot;&gt;Relational DB (3NF Integrity)&lt;br/&gt;Row Level Security (RLS)&lt;br/&gt;Users, Lessons, PK Battles&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#38BDF8;strokeWidth=1.5;shadow=1;fontSize=12;fontColor=#0C4A6E;align=center;size=10;" vertex="1" parent="tier3">
          <mxGeometry x="30" y="45" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="card3_2" value="&lt;b&gt;Supabase Auth Gateway&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#0369A1&quot; style=&quot;font-size: 11px;&quot;&gt;Identity Provider Service&lt;br/&gt;OAuth2 &amp;amp; JWT Issuance&lt;br/&gt;User &amp;amp; Role Identity Management&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#38BDF8;strokeWidth=1.5;shadow=1;fontSize=12;fontColor=#0C4A6E;align=center;" vertex="1" parent="tier3">
          <mxGeometry x="310" y="45" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="card3_3" value="&lt;b&gt;Supabase Object Storage&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#0369A1&quot; style=&quot;font-size: 11px;&quot;&gt;S3-Compatible Storage Buckets&lt;br/&gt;Avatars &amp;amp; User Media&lt;br/&gt;Teacher Diploma Documents&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#38BDF8;strokeWidth=1.5;shadow=1;fontSize=12;fontColor=#0C4A6E;align=center;" vertex="1" parent="tier3">
          <mxGeometry x="580" y="45" width="250" height="110" as="geometry" />
        </mxCell>

        <!-- CONNECTORS -->
        <!-- HTTP/REST Edge from React SPA to Express Server -->
        <mxCell id="conn_http" value="HTTP / HTTPS RESTful API&lt;br/&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:10px;&quot;&gt;(Synchronous Requests)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4B5563;strokeWidth=2;fontSize=11;fontColor=#374151;fontStyle=1;labelBackgroundColor=#FFFFFF;spacing=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.35;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="card1_1" target="card2_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- WebSockets Edge from Context/SPA to Realtime Gateway -->
        <mxCell id="conn_ws" value="WebSockets / Supabase Realtime&lt;br/&gt;&lt;font color=&quot;#2563EB&quot; style=&quot;font-size:10px;&quot;&gt;(Bi-directional Communication)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=5 5;strokeColor=#2563EB;strokeWidth=2;fontSize=11;fontColor=#1D4ED8;fontStyle=1;labelBackgroundColor=#FFFFFF;spacing=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="card1_3" target="card2_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Express Server to PostgreSQL DB -->
        <mxCell id="conn_express_db" value="SQL Queries / Service Role" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;fontSize=10;fontColor=#047857;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="card2_1" target="card3_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Express Server to Supabase Auth -->
        <mxCell id="conn_express_auth" value="JWT Token Verification" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;fontSize=10;fontColor=#047857;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="card2_1" target="card3_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Realtime Gateway to PostgreSQL DB -->
        <mxCell id="conn_realtime_db" value="CDC / Replication" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=3 3;strokeColor=#0284C7;strokeWidth=1.5;fontSize=10;fontColor=#0369A1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="card2_2" target="card3_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- React SPA Direct Upload to Storage -->
        <mxCell id="conn_storage" value="Direct Media Upload (SDK)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=4 4;strokeColor=#9CA3AF;strokeWidth=1.5;fontSize=10;fontColor=#4B5563;labelBackgroundColor=#FFFFFF;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="card1_2" target="card3_3">
